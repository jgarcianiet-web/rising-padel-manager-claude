{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rising Pádel Manager",
  "version": "3.1.0",
  "identifier": "com.risinggames.padelmanager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rising Pádel Manager",
        "width": 1360,
        "height": 880,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© Rising Games",
    "category": "Game",
    "shortDescription": "El Football Manager del pádel",
    "longDescription": "Gestiona tu carrera o tu club de pádel: entrena, ficha personal, negocia patrocinios y conquista el circuito mundial. Un juego de Rising Games."
  }
}
